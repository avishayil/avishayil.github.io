---
import { SITE, CONTACT } from '../lib/site';

interface Props {
  stats: { value: string; label: string }[];
}
const { stats } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
    <div class="hero__col">
      <p class="hero__eyebrow">{SITE.role}</p>
      <h1 id="hero-title" class="hero__title">
        Secure the AI you build, <span class="hero__accent">and the AI you run.</span>
      </h1>
      <p class="hero__intro">{SITE.intro}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href={CONTACT.booking} target="_blank" rel="noopener">
          Book a free intro call
        </a>
        <a class="btn" href="/#services">See services</a>
      </div>

      <ul class="hero__trust">
        {stats.map((s) => (
          <li>
            <span class="hero__trust-value">{s.value}</span>
            <span class="hero__trust-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(4.5rem, 3rem + 10vw, 9rem) var(--space-section);
    overflow: hidden;
  }
  /* soft radial glow behind the headline — subtle, professional */
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 60%;
    background: radial-gradient(
      60% 100% at 20% 0%,
      var(--accent-glow),
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
  }
  .hero__col {
    max-width: 46rem;
  }
  .hero__eyebrow {
    color: var(--accent);
    font-weight: 600;
    font-size: var(--step-0);
    letter-spacing: 0.02em;
    margin-bottom: 1.25rem;
  }
  .hero__title {
    font-size: var(--step-4);
  }
  .hero__accent {
    color: var(--text-muted);
  }
  .hero__intro {
    max-width: 42ch;
    color: var(--text-muted);
    font-size: var(--step-1);
    margin-top: 1.5rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  .hero__trust {
    list-style: none;
    padding: 2.5rem 0 0;
    margin-top: 2.5rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
  }
  .hero__trust li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .hero__trust-value {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--text);
  }
  .hero__trust-label {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
