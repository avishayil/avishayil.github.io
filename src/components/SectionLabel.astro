---
interface Props {
  index: string;
  label: string;
  title?: string;
  lede?: string;
}
const { index, label, title, lede } = Astro.props;
---

<div class="section-label">
  <p class="section-label__eyebrow">
    <span class="section-label__index">{index}</span>
    {label}
  </p>
  {title && <h2 class="section-label__title">{title}</h2>}
  {lede && <p class="section-label__lede">{lede}</p>}
</div>

<style>
  .section-label {
    margin-bottom: 2.5rem;
  }
  .section-label__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .section-label__index {
    color: var(--text-faint);
    font-family: var(--font-mono);
  }
  .section-label__title {
    font-size: var(--step-3);
    margin-top: 1rem;
    max-width: 20ch;
  }
  .section-label__lede {
    color: var(--text-muted);
    font-size: var(--step-1);
    margin-top: 1rem;
    max-width: 52ch;
  }
</style>
