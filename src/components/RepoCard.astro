---
import type { Repo } from '../lib/github';
interface Props {
  repo: Repo;
}
const { repo } = Astro.props;

/** Compact number, e.g. 12500 → "12.5k". */
function compact(n: number): string {
  if (n >= 1000) {
    const k = n / 1000;
    return `${k >= 10 ? Math.round(k) : k.toFixed(1)}k`;
  }
  return String(n);
}
---

<a class="repo" href={repo.url} target="_blank" rel="noopener">
  <div class="repo__head">
    <span class="repo__name mono">{repo.name}</span>
    <span class="repo__metrics mono">
      <span class="repo__stars" aria-label={`${repo.stars} stars`}>★ {compact(repo.stars)}</span>
      {typeof repo.downloads === 'number' && (
        <span class="repo__downloads" aria-label={`${repo.downloads} npm downloads last month`}>
          ⭳ {compact(repo.downloads)}/mo
        </span>
      )}
    </span>
  </div>
  <p class="repo__desc">{repo.description}</p>
  <div class="repo__meta mono">
    {repo.language && <span class="repo__lang">{repo.language}</span>}
    {repo.topics.slice(0, 3).map((t) => (
      <span class="repo__topic">#{t}</span>
    ))}
  </div>
</a>

<style>
  .repo {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    height: 100%;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .repo:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .repo__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .repo__name {
    color: var(--text);
    font-weight: 500;
  }
  .repo:hover .repo__name {
    color: var(--accent);
  }
  .repo__metrics {
    display: flex;
    gap: 0.75rem;
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .repo__stars {
    color: var(--text-muted);
  }
  .repo__downloads {
    color: var(--accent-dim);
  }
  .repo__desc {
    color: var(--text-muted);
    font-size: var(--step-0);
    flex: 1;
  }
  .repo__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    color: var(--text-faint);
  }
  .repo__lang {
    color: var(--accent-dim);
  }
</style>
