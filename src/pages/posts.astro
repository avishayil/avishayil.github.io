---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPosts } from '../lib/posts';
import { SITE, SOCIAL } from '../lib/site';

const posts = await getPosts();
---

<Base
  title={`Posts & Notes · ${SITE.name}`}
  description="Posts and notes on AI security, cloud security, and secure development by Avishay Bar."
>
  <section class="section section--first">
    <div class="wrap">
      <SectionLabel index="04" label="Posts & Notes" />
      <h1 class="page-title">Posts & Notes</h1>
      <p class="page-lead">
        Short takes from
        <a href={SOCIAL.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        and longer pieces from
        <a href={SOCIAL.medium} target="_blank" rel="noopener">Medium</a>.
      </p>
      <div class="list">
        {posts.map((post) => <ArticleCard post={post} />)}
      </div>
      <a class="more" href="/#posts">← Back home</a>
    </div>
  </section>
</Base>

<style>
  .section--first {
    border-top: none;
    padding-top: clamp(3rem, 2rem + 6vw, 6rem);
  }
  .page-title {
    font-size: var(--step-4);
    line-height: 1;
  }
  .page-lead {
    color: var(--text-muted);
    max-width: 48ch;
    margin: 1.25rem 0 2rem;
    font-size: var(--step-1);
  }
  .page-lead a {
    color: var(--accent);
  }
  .more {
    display: inline-block;
    margin-top: 3rem;
    color: var(--text-muted);
  }
  .more:hover {
    color: var(--accent);
  }
</style>
